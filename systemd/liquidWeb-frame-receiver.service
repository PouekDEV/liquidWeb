[Unit]
Description=liquidWeb Frame Receiver
After=network.target liquidWeb-integration-runner.service
Wants=liquidWeb-integration-runner.service

[Service]
User=liquidWeb
Group=liquidWeb
Type=simple
ExecStart=/usr/lib/liquidWeb/frame-receiver/frame-receiver 50 90 54217
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=liquidWeb.target