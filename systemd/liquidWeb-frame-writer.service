[Unit]
Description=liquidWeb Frame Writer
After=network.target liquidWeb-integration-runner.service
Wants=liquidWeb-integration-runner.service
PartOf=liquidWeb.target

[Service]
User=liquidWeb
Group=liquidWeb
Type=simple
ExecStart=/usr/lib/liquidWeb/frame-writer/frame-writer 50 90 54217
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=liquidWeb.target